{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openshelf.dev/schema/index.schema.json",
  "title": "OpenShelf generated index",
  "description": "Generated by tools/build-index.mjs. NEVER edit by hand. The client app downloads this file plus index.json.sig and verifies the signature before trusting a single byte of it.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "apps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generator": { "type": "string" },
    "signingKeyId": {
      "type": "string",
      "description": "Short fingerprint of the index signing key, so the client can tell which key signed this and detect an unexpected rotation."
    },
    "indexUrl": { "type": "string", "description": "Self-reference, for logs." },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "summary", "packageName", "license", "sourceCode", "artifact"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "summary": { "type": "string" },
          "description": { "type": "object", "additionalProperties": { "type": "string" } },
          "packageName": { "type": "string" },
          "license": { "type": "string" },
          "sourceCode": { "type": "string" },
          "author": { "type": "string" },
          "categories": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" },
          "antiFeatures": { "type": "array", "items": { "type": "string" } },
          "links": { "type": "object" },
          "playStore": { "type": "object" },
          "addedAt": { "type": "string" },
          "icon": {
            "type": ["string", "null"],
            "description": "Path RELATIVE to this index.json (e.g. icons/f-droid.png). Relative on purpose: the client resolves it against whatever URL served the index, so mirrors and forks work with no configuration. null means the client draws a monogram."
          },
          "screenshots": { "type": "array", "items": { "type": "string" } },
          "downloadCount": { "type": ["integer", "null"], "description": "Best-effort popularity signal from the upstream host." },
          "signingCertSha256": { "type": ["string", "null"] },
          "resolvedAt": { "type": "string", "format": "date-time" },
          "release": {
            "type": "object",
            "required": ["versionName", "versionCode", "tag"],
            "properties": {
              "versionName": { "type": "string" },
              "versionCode": { "type": "integer" },
              "tag": { "type": "string" },
              "publishedAt": { "type": ["string", "null"] },
              "releaseUrl": { "type": ["string", "null"] },
              "changelog": { "type": ["string", "null"] },
              "assets": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["abi", "url", "sha256", "size"],
                  "properties": {
                    "abi": { "enum": ["universal", "arm64-v8a", "armeabi-v7a", "x86", "x86_64"] },
                    "url": { "type": "string" },
                    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "size": { "type": "integer", "minimum": 1 },
                    "signingCertSha256": { "type": ["string", "null"] },
                    "versionCode": { "type": "integer" },
                    "versionName": { "type": "string" },
                    "minSdk": { "type": ["integer", "null"] },
                    "targetSdk": { "type": ["integer", "null"] },
                    "nativeAbis": { "type": "array", "items": { "type": "string" } },
                    "verifiedAt": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "artifact": {
            "type": "object",
            "description": "Convenience pointer to the preferred artifact (universal, else abiAssets order). Clients that only want 'install this' can use it and still verify sha256.",
            "required": ["url", "sha256", "size", "abi"],
            "properties": {
              "url": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "size": { "type": "integer" },
              "abi": { "type": "string" }
            }
          },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
